# API server port. Defaults to 4000 when omitted.
PORT=4000

# Required MongoDB connection URI for the API.
MONGODB_URI=

# Optional DNS server for MongoDB SRV record resolution. Defaults to 1.1.1.1.
MONGODB_DNS_SERVER=1.1.1.1

# Required secret used to sign and verify JWT access tokens.
JWT_SECRET=

# Optional JWT access-token lifetime. Defaults to 1h; use a whole number plus s, m, h, or d.
JWT_EXPIRES_IN=1h
